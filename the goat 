</main>

<div class="wrap">
  <footer>
    <span>&copy; Steele Systems &middot; Mississauga, Ontario</span>
    <span>Run by Bohdey Steele &middot; <a href="mailto:wbohdeysteele@gmail.com">wbohdeysteele@gmail.com</a></span>
  </footer>
</div>
<div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="mt">
  <div class="box">
    <h3 id="mt">Start your free 2-week trial</h3>
    <p>Email me and I&rsquo;ll get back to you to set up a quick call.</p>
    <div class="em" id="em">wbohdeysteele@gmail.com</div>
    <div class="row">
      <button class="btn sm" id="copy" type="button">Copy email</button>
      <a class="btn sm ghost" href="mailto:wbohdeysteele@gmail.com?subject=Free%202-week%20trial">Open email app</a>
    </div>
    <button class="x" id="close" type="button">Close</button>
  </div>
</div>
<script>
(function(){
  var m=document.getElementById("modal"),c=document.getElementById("copy");
  document.querySelectorAll('a.btn[href^="mailto:"]').forEach(function(a){
    if(m.contains(a))return;
    a.addEventListener("click",function(e){e.preventDefault();c.textContent="Copy email";m.classList.add("on");});
  });
  function close(){m.classList.remove("on");}
  document.getElementById("close").addEventListener("click",close);
  m.addEventListener("click",function(e){if(e.target===m)close();});
  document.addEventListener("keydown",function(e){if(e.key==="Escape")close();});
  c.addEventListener("click",function(){
    var t="wbohdeysteele@gmail.com";
    function done(){c.textContent="Copied ✓";}
    function fallback(){try{var r=document.createRange();r.selectNodeContents(document.getElementById("em"));var s=getSelection();s.removeAllRanges();s.addRange(r);c.textContent="Selected, now copy";}catch(e){}}
    try{navigator.clipboard.writeText(t).then(done,fallback);}catch(e){fallback();}
  });
})();
</script>
