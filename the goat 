<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Steele Systems | Never lose a job to a missed call</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#fafbfd;--surface:#ffffff;--soft:#f0f3f9;--text:#0b1424;--muted:#56637b;--accent:#ff6a1a;--accent-d:#e0560b;--on-accent:#ffffff;--border:#e1e7f0;--ink:#0b1424;--on-ink:#f4f7fc;--shadow:0 18px 50px rgba(11,20,36,.10);
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#080d17;--surface:#101826;--soft:#0e1522;--text:#eef2f9;--muted:#98a6bd;--accent:#ff7d36;--accent-d:#ff6a1a;--on-accent:#120a04;--border:#212d44;--ink:#05080f;--on-ink:#eef2f9;--shadow:0 18px 50px rgba(0,0,0,.45)}}
:root[data-theme="dark"]{--bg:#080d17;--surface:#101826;--soft:#0e1522;--text:#eef2f9;--muted:#98a6bd;--accent:#ff7d36;--accent-d:#ff6a1a;--on-accent:#120a04;--border:#212d44;--ink:#05080f;--on-ink:#eef2f9;--shadow:0 18px 50px rgba(0,0,0,.45)}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 72px);scroll-behavior:smooth;height:100%}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:"Plus Jakarta Sans",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;line-height:1.6;-webkit-font-smoothing:antialiased}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:30}
a{color:inherit}
.wrap{max-width:1100px;margin:0 auto;padding:0 22px}
header.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(12px);border-bottom:1px solid var(--border)}
.bar .wrap{display:flex;align-items:center;justify-content:space-between;height:68px}
.logo{display:flex;align-items:center;gap:10px;font-weight:800;text-decoration:none;letter-spacing:-.02em}
.mark{width:32px;height:32px;border-radius:9px;background:var(--accent);color:var(--on-accent);display:grid;place-items:center;font-size:1rem}
.links{display:flex;align-items:center;gap:26px;font-size:.93rem;font-weight:500;color:var(--muted)}
.links a{text-decoration:none}.links a:hover{color:var(--text)}
.btn{display:inline-flex;align-items:center;gap:8px;background:var(--accent);color:var(--on-accent);padding:14px 26px;border-radius:12px;font-weight:700;text-decoration:none;font-size:1rem;box-shadow:0 8px 22px color-mix(in srgb,var(--accent) 35%,transparent);transition:transform .15s,background .15s}
.btn:hover{background:var(--accent-d);transform:translateY(-1px)}
.btn.sm{padding:10px 18px;font-size:.9rem;box-shadow:none}
.btn.ghost{background:transparent;color:var(--text);border:1px solid var(--border);box-shadow:none}
.btn.ghost:hover{background:var(--soft)}
@media(max-width:720px){.links a:not(.btn){display:none}}

.hero{padding:72px 0 80px;display:grid;gap:56px;grid-template-columns:1.1fr .9fr;align-items:center}
@media(max-width:860px){.hero{grid-template-columns:1fr;padding:48px 0 56px}}
.eyebrow{display:inline-block;font-size:.8rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);background:color-mix(in srgb,var(--accent) 12%,transparent);padding:6px 12px;border-radius:999px;margin-bottom:20px}
h1{font-size:clamp(2.3rem,5.6vw,3.7rem);line-height:1.05;letter-spacing:-.035em;margin:0 0 20px;font-weight:800}
h1 em{font-style:normal;color:var(--accent)}
.sub{font-size:1.15rem;color:var(--muted);max-width:50ch;margin:0 0 30px}
.cta{display:flex;gap:12px;flex-wrap:wrap}
.note{font-size:.85rem;color:var(--muted);margin-top:16px}
.phone{background:var(--ink);border-radius:36px;padding:12px;max-width:340px;margin:0 auto;box-shadow:var(--shadow);transform:rotate(2deg)}
.screen{background:var(--surface);border-radius:26px;padding:18px 16px 22px;display:flex;flex-direction:column;gap:10px;min-height:400px}
.top{display:flex;justify-content:space-between;font-size:.72rem;color:var(--muted);padding-bottom:8px;border-bottom:1px solid var(--border)}
.miss{font-size:.78rem;color:#d63b3b;font-weight:700;text-align:center;background:color-mix(in srgb,#d63b3b 10%,transparent);border-radius:10px;padding:8px}
.m{padding:10px 14px;border-radius:18px;font-size:.88rem;max-width:84%;line-height:1.4}
.a{background:var(--accent);color:var(--on-accent);align-self:flex-start;border-bottom-left-radius:5px}
.b{background:var(--soft);border:1px solid var(--border);align-self:flex-end;border-bottom-right-radius:5px}
.ok{font-size:.78rem;color:#1f9d55;font-weight:700;text-align:center;background:color-mix(in srgb,#1f9d55 11%,transparent);border-radius:10px;padding:8px;margin-top:auto}

.trades{border-block:1px solid var(--border);background:var(--soft)}
.trades .wrap{display:flex;flex-wrap:wrap;gap:10px 28px;justify-content:center;padding-block:20px;color:var(--muted);font-weight:600;font-size:.92rem}
.trades b{color:var(--text);font-weight:700}

section.s{padding:84px 0}
.head{max-width:620px;margin-bottom:44px}
.head h2{font-size:clamp(1.8rem,4vw,2.5rem);letter-spacing:-.03em;line-height:1.12;margin:0 0 12px;font-weight:800}
.head p{color:var(--muted);margin:0;font-size:1.05rem}
.tl{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}
.step{background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:26px;position:relative}
.step .t{font-size:.8rem;font-weight:700;color:var(--accent);letter-spacing:.04em;margin-bottom:10px}
.step h3{margin:0 0 6px;font-size:1.1rem;letter-spacing:-.01em}
.step p{margin:0;color:var(--muted);font-size:.94rem}
.cap{font-size:.8rem;color:var(--muted);margin-top:14px}

.ink{background:var(--ink);color:var(--on-ink)}
.ink .head p{color:color-mix(in srgb,var(--on-ink) 70%,transparent)}
.feat{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
.f{border:1px solid color-mix(in srgb,var(--on-ink) 14%,transparent);border-radius:18px;padding:26px;background:color-mix(in srgb,var(--on-ink) 4%,transparent)}
.f .i{width:42px;height:42px;border-radius:12px;background:color-mix(in srgb,var(--accent) 18%,transparent);display:grid;place-items:center;font-size:1.2rem;margin-bottom:14px}
.f h3{margin:0 0 6px;font-size:1.08rem}
.f p{margin:0;font-size:.93rem;color:color-mix(in srgb,var(--on-ink) 68%,transparent)}

.faq{max-width:760px}
details{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:18px 22px;margin-bottom:12px}
summary{cursor:pointer;font-weight:700;list-style:none;display:flex;justify-content:space-between;gap:14px}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";color:var(--accent);font-size:1.4rem;line-height:1}
details[open] summary::after{content:"\2212"}
details p{margin:12px 0 0;color:var(--muted)}

.final{background:linear-gradient(135deg,var(--accent),var(--accent-d));color:var(--on-accent);border-radius:28px;padding:56px 28px;text-align:center}
.final h2{font-size:clamp(1.8rem,4.4vw,2.6rem);letter-spacing:-.03em;margin:0 0 12px;font-weight:800}
.final p{margin:0 auto 26px;max-width:46ch;opacity:.92}
.final .btn{background:var(--ink);color:var(--on-ink);box-shadow:none}
.final ul{list-style:none;padding:0;margin:0 0 28px;display:flex;flex-wrap:wrap;gap:8px 22px;justify-content:center;font-weight:600;font-size:.94rem}
.modal{position:fixed;inset:0;z-index:50;display:none;align-items:center;justify-content:center;background:rgba(5,8,15,.55);padding:20px}
.modal.on{display:flex}
.box{background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:20px;padding:28px 24px;max-width:420px;width:100%;box-shadow:var(--shadow);text-align:center}
.box h3{margin:0 0 6px;font-size:1.3rem;letter-spacing:-.02em}
.box p{margin:0 0 18px;color:var(--muted);font-size:.95rem}
.em{font-weight:700;font-size:1.05rem;background:var(--soft);border:1px solid var(--border);border-radius:12px;padding:12px;margin-bottom:16px;word-break:break-all;user-select:all}
.box .row{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.box button.btn{border:0;cursor:pointer;font-family:inherit}
.x{background:none;border:0;color:var(--muted);margin-top:14px;cursor:pointer;font:inherit;font-size:.9rem}
footer{padding:36px 0 44px;color:var(--muted);font-size:.88rem;display:flex;flex-wrap:wrap;gap:10px 24px;justify-content:space-between}
</style>
</head>
<body>
<header class="bar">
  <div class="wrap">
    <a class="logo" href="#top"><span class="mark">&#9742;</span>Steele Systems</a>
    <nav class="links"><a href="#how">How it works</a><a href="#why">Why it works</a><a href="#faq">FAQ</a><a class="btn sm" href="mailto:wbohdeysteele@gmail.com?subject=Free%202-week%20trial">Free trial</a></nav>
  </div>
</header>

<main id="top">
  <div class="wrap hero">
    <div>
